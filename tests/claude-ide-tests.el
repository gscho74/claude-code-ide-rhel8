;;; Integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'claude-ide)
(defvar ghostel-module-directory)
(defvar ghostel-module-auto-install)
(defconst claude-test-directory (file-name-directory (or load-file-name buffer-file-name)))
(ert-deftest claude-cli-native-options ()
  (let* ((args (claude-ide-terminal--arguments "/tmp/root with spaces" "/tmp/editor with spaces.json"))
         (config (json-parse-string (cadr (member "--mcp-config" args))))
         (server (gethash "emacs_editor" (gethash "mcpServers" config))))
    (should (equal (cadr (member "--permission-mode" args)) "default"))
    (should (equal (aref (gethash "args" server) 1) "/tmp/editor with spaces.json"))
    (should (equal (gethash "type" server) "stdio"))
    (should-not (member "--sandbox" args))
    (should-not (member "-c" args))
    (should-not (member "--no-alt-screen" args))))
(ert-deftest claude-resume-and-delete ()
  (let ((args (claude-ide-terminal--command "claude" "/tmp" "/tmp/state.json" t)))
    (should (equal (car args) "claude"))
    (should (equal (car (last args)) "--resume")))
  (should-error (claude-ide-terminal--command "claude" "/tmp" "/tmp/state" 'delete)
                :type 'user-error))
(ert-deftest claude-source-selection-hangul ()
  (let ((root (make-temp-file "claude-test-" t))
        (transient-mark-mode t)
        (claude-ide--sessions (make-hash-table :test 'equal)))
    (unwind-protect
        (with-temp-buffer
          (setq buffer-file-name (expand-file-name "한글.sv" root))
          (insert "module demo;\n// 한글 입력\nendmodule\n")
          (goto-char (point-min)) (forward-line 1)
          (set-mark (point)) (forward-line 1)
          (setq mark-active t)
          (let ((context (claude-ide--context)))
            (should (string-match-p "한글 입력" context))
            (should (string-match-p "한글.sv" context))
            (should-not (string-match-p "endmodule" (cadr (split-string context "Selected source:"))))))
      (delete-directory root t))))
(ert-deftest claude-private-state-and-cleanup ()
  (let* ((runtime (make-temp-file "claude-state-" t))
         (state (expand-file-name "editor.json" runtime))
         (claude-ide--sessions (make-hash-table :test 'equal)))
    (unwind-protect
        (with-temp-buffer
          (setq-local claude-ide-terminal--runtime runtime
                      claude-ide-terminal--state-file state
                      claude-ide--cwd "/tmp/" claude-ide--thread-id "test")
          (claude-ide-terminal--publish-context)
          (should (file-exists-p state))
          (should (= 0 (logand (file-modes state) #o077)))
          (should (hash-table-p (json-parse-string
                                (with-temp-buffer (insert-file-contents state) (buffer-string)))))
          (claude-ide-terminal--cleanup)
          (should-not (file-exists-p runtime)))
      (when (file-exists-p runtime) (delete-directory runtime t)))))
(defun claude-test-wait-for (buffer text)
  (let ((deadline (+ (float-time) 4)))
    (while (and (< (float-time) deadline)
                (not (with-current-buffer buffer
                       (string-match-p text (buffer-string)))))
      (accept-process-output nil 0.05))
    (should (with-current-buffer buffer (string-match-p text (buffer-string))))))
(defun claude-test-pty-roundtrip (backend)
  (let* ((root (make-temp-file "claude-project-" t))
         (default-directory root)
         (claude-ide-terminal-backend backend)
         (claude-ide-executable (expand-file-name "fake-claude.py" claude-test-directory))
         (claude-ide--sessions (make-hash-table :test 'equal))
         (claude-ide--active-id nil)
         (source (generate-new-buffer "test-source"))
         terminal runtime)
    (unwind-protect
        (progn
          (switch-to-buffer source)
          (setq buffer-file-name (expand-file-name "sample.sv" root))
          (insert "// 한글 선택 영역\n")
          (setq terminal (claude-ide-terminal))
          (setq runtime (buffer-local-value 'claude-ide-terminal--runtime terminal))
          (claude-test-wait-for terminal "FAKE_READY")
          (claude-ide-terminal-send-prompt terminal "테스트 질문" " [context]")
          (claude-test-wait-for terminal "테스트 질문")
          (should (file-exists-p (expand-file-name "editor.json" runtime))))
      (when (buffer-live-p terminal)
        (let ((kill-buffer-query-functions nil))
          (with-current-buffer terminal
            (when-let* ((p (get-buffer-process terminal)))
              (set-process-query-on-exit-flag p nil) (delete-process p)))
          (kill-buffer terminal)))
      (when (buffer-live-p source) (kill-buffer source))
      (delete-directory root t))
    (should-not (file-exists-p runtime))))

(ert-deftest claude-context-isolated-between-projects ()
  (let* ((root-a (make-temp-file "claude-a-" t))
         (root-b (make-temp-file "claude-b-" t))
         (a (generate-new-buffer "source-a"))
         (b (generate-new-buffer "source-b"))
         (session (generate-new-buffer "session-a"))
         (claude-ide--sessions (make-hash-table :test 'equal))
         (claude-ide--active-id "a"))
    (unwind-protect
        (progn
          (with-current-buffer a (setq buffer-file-name (expand-file-name "a.sv" root-a)))
          (with-current-buffer b (setq buffer-file-name (expand-file-name "b.sv" root-b)))
          (with-current-buffer session
            (setq-local claude-ide--cwd root-a claude-ide--thread-id "a"
                        claude-ide--editor-buffer a))
          (puthash "a" session claude-ide--sessions)
          (with-current-buffer b (claude-ide--track))
          (should (eq (buffer-local-value 'claude-ide--editor-buffer session) a))
          (with-current-buffer session
            (should (string-match-p "a.sv" (claude-ide--context)))
            (should-not (string-match-p "b.sv" (claude-ide--context)))))
      (mapc #'kill-buffer (list a b session))
      (delete-directory root-a t) (delete-directory root-b t))))

(ert-deftest claude-terminal-real-pty-roundtrip ()
  (claude-test-pty-roundtrip 'term))
(ert-deftest claude-ghostel-native-pty-roundtrip ()
  (let ((ghostel-module-directory
         (expand-file-name "../vendor/ghostel" claude-test-directory))
        (ghostel-module-auto-install nil))
    (skip-unless (file-readable-p (expand-file-name "ghostel-module.so" ghostel-module-directory)))
    (claude-test-pty-roundtrip 'ghostel)))
(ert-deftest claude-korean-ime-prefix-editing ()
  (let ((claude-ide-terminal--streamed-ime-text "가나") sent)
    (cl-letf (((symbol-function 'ghostel--terminal-input-mode-p) (lambda () t))
              ((symbol-function 'ghostel--send-encoded)
               (lambda (key _modifiers) (push key sent)))
              ((symbol-function 'ghostel--send-string)
               (lambda (text) (push (decode-coding-string text 'utf-8) sent))))
      (claude-ide-terminal--send-ime-delta "가다")
      (should (equal (nreverse sent) '("backspace" "다")))
      (should (equal claude-ide-terminal--streamed-ime-text "가다")))))
